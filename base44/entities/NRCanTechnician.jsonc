{
  "name": "NRCanTechnician",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Last Name, First Name as it appears in the NRCan directory"
    },
    "reg_number": {
      "type": "string",
      "description": "NRCan registration number (not available in public directory data; manually entered if known)"
    },
    "employer": {
      "type": "string",
      "description": "Employer name (not available in public directory data; manually entered if known)"
    },
    "city": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "expiry_date": {
            "type": "string",
            "description": "NRCan Renewal Due Date (YYYY-MM-DD)"
          }
        }
      }
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}