{
  "name": "Certification",
  "type": "object",
  "properties": {
    "technician_name": {
      "type": "string"
    },
    "technician_email": {
      "type": "string",
      "format": "email"
    },
    "certification_name": {
      "type": "string"
    },
    "certification_number": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "ndt_mt",
        "ndt_ut",
        "ndt_pt",
        "ndt_rt",
        "ndt_et",
        "ndt_vt",
        "ndt_ut_pa",
        "ndt_xf",
        "ndt_cedo",
        "other"
      ]
    },
    "governing_body": {
      "type": "string",
      "enum": [
        "NRCan",
        "CNSC"
      ]
    },
    "scs_applicable": {
      "type": "boolean"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "employer_name": {
      "type": "string"
    },
    "employer_email": {
      "type": "string",
      "format": "email"
    },
    "supervisor_name": {
      "type": "string"
    },
    "supervisor_email": {
      "type": "string",
      "format": "email"
    },
    "nrcan_id": {
      "type": "string"
    },
    "document_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "technician_name",
    "certification_name",
    "expiry_date"
  ]
}