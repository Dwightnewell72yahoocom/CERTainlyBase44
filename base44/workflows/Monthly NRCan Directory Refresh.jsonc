{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_nrcan_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_directory": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "seedNRCanDirectory",
            "args": {
              "force": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh NRCan Directory",
            "description": "Re-pulls the latest NRCan JSON and updates all technician records"
          }
        }
      }
    ]
  },
  "name": "Monthly NRCan Directory Refresh",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 1 * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Refreshes the NRCan technician directory from the official NRCan JSON source on the 1st of each month"
}